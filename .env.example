# --- Base de données (Railway PostgreSQL) --------------------------------
# En local : chaîne de connexion vers votre Postgres de dev.
# Sur Railway : référencez la variable fournie par le plugin PostgreSQL,
# ex. DATABASE_URL="${{Postgres.DATABASE_URL}}"
DATABASE_URL="postgresql://user:password@localhost:5432/ssa_gprp?schema=public"

# --- NextAuth --------------------------------------------------------------
# Générez une valeur avec : openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-forte"
# URL publique de l'application (ex. https://ssa-gprp.up.railway.app en prod)
NEXTAUTH_URL="http://localhost:3000"

# --- Application ------------------------------------------------------------
# NODE_ENV : à ne PAS définir manuellement comme variable Railway. Next.js le
# positionne lui-même à "production" pour `next build`/`next start`. Le forcer
# comme variable de service fait sauter les devDependencies lors de `npm ci`
# pendant le build (typescript, tailwindcss...) et casse la résolution des
# alias "@/..." de façon imprévisible.
NODE_ENV="development"
