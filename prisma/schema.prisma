// Schéma Prisma — SSA GPRP (Gestion du Personnel et des Régimes de Protection)
// Base de données : PostgreSQL (Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  // Médicaux
  MEDECIN_CHEF
  MEDECIN_PRINCIPAL
  MEDECIN_ARMES
  INTERNE_MEDECINE
  EXTERNE_MEDECINE
  // Paramédicaux
  CADRE_SANTE
  INFIRMIER_MAJOR
  INFIRMIER_ANESTHESISTE
  INFIRMIER
  ETUDIANT_INFIRMIER
  // Commandement
  COMMANDEMENT
}

enum AptitudeStatus {
  APTE
  APTE_RESTRICTION
  INAPTE
  NON_EVALUE
}

enum ConclusionEngagement {
  APTE_ENGAGEMENT
  INAPTE_TEMPORAIRE
  INAPTE
  AJOURNEMENT
}

enum ConclusionSuivi {
  APTE_A_SERVIR
  APTE_A_SERVIR_AVEC_RESTRICTION
  INAPTE_TEMPORAIRE_A_SERVIR
  INAPTE_DEFINITIF_A_SERVIR
}

enum TypeExemption {
  ARRET_TRAVAIL
  EXEMPTION_SPORT
  EXEMPTION_SERVICE
  PERMISSION_EXCEPTIONNELLE
  CONVALESCENCE
}

enum StatutConvocation {
  PLANIFIEE
  HONOREE
  ANNULEE
  ABSENT
}

// ---------------------------------------------------------------------------
// MODELS
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  nom          String
  prenom       String
  email        String   @unique
  passwordHash String
  role         Role
  grade        String
  actif        Boolean  @default(true)

  // Signature manuscrite (PNG fond transparent), apposée automatiquement
  // sur les certificats et ordonnances générés par cet utilisateur.
  signature       Bytes?
  signatureAjoutee DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profilsSigycopEvalues ProfilSigycop[]            @relation("MedecinProfilsSigycop")
  certificatsEngagement CertificatEngagement[]     @relation("MedecinCertificatsEngagement")
  certificatsSuivi      CertificatSuiviAptitudes[] @relation("MedecinCertificatsSuivi")
  consultations         Consultation[]             @relation("MedecinConsultations")
  prescriptions         Prescription[]             @relation("MedecinPrescriptions")
  arretsTravail         ArretTravail[]             @relation("MedecinArretsTravail")
  convocations          Convocation[]              @relation("MedecinConvocations")
  journalEntries        JournalAudit[]             @relation("AuteurJournal")
  piecesJointesAjoutees PieceJointe[]              @relation("AjouteParPieceJointe")

  @@map("users")
}

model Patient {
  id         String   @id @default(cuid())
  rio        String   @unique // Identifiant défense
  nom        String
  prenom     String
  ddn        DateTime
  grade      String
  specialite String?
  unite      String

  // Affichés en tête de dossier ; les allergies déclenchent une alerte lors
  // de la rédaction d'une ordonnance.
  antecedents String? @db.Text
  allergies   String? @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profilsSigycop        ProfilSigycop[]
  certificatsEngagement CertificatEngagement[]
  certificatsSuivi      CertificatSuiviAptitudes[]
  consultations         Consultation[]
  prescriptions         Prescription[]
  arretsTravail         ArretTravail[]
  convocations          Convocation[]
  journalEntries        JournalAudit[]

  @@map("patients")
}

/// Seuils réglementaires d'inaptitude par défaut : S2 I2 G2 Y3 C3 O2 P1
/// (voir lib/sigycop.ts::SIGYCOP_SEUILS_INAPTITUDE)
model ProfilSigycop {
  id             String   @id @default(cuid())
  s              Int      @default(1)
  i              Int      @default(1)
  g              Int      @default(1)
  y              Int      @default(1)
  c              Int      @default(1)
  o              Int      @default(1)
  p              Int      @default(1)
  dateEvaluation DateTime @default(now())

  medecin   User   @relation("MedecinProfilsSigycop", fields: [medecinId], references: [id])
  medecinId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  certificatsEngagement CertificatEngagement[]
  certificatsSuivi      CertificatSuiviAptitudes[]

  createdAt DateTime @default(now())

  @@index([patientId])
  @@map("profils_sigycop")
}

model CertificatEngagement {
  id String @id @default(cuid())

  // En-tête (dénormalisé depuis Patient au moment de l'édition pour figer le document)
  nom    String
  prenom String
  ddn    DateTime
  rio    String

  // Grille SIGYCOP figée sur le certificat
  s Int
  i Int
  g Int
  y Int
  c Int
  o Int
  p Int

  // Tableau des aptitudes
  aptitudeGeneraleSPP  AptitudeStatus @default(NON_EVALUE) // Aptitude générale au service / engagement (SAPEURS-POMPIERS DE PARIS)
  aptitudeInitialeGES  AptitudeStatus @default(NON_EVALUE)
  aptitudeMIR          AptitudeStatus @default(NON_EVALUE)
  aptitudeGRIMP        AptitudeStatus @default(NON_EVALUE)
  aptitudeNRBCe        AptitudeStatus @default(NON_EVALUE)
  aptitudeGHSC         AptitudeStatus @default(NON_EVALUE)
  conduiteGroupeLeger  AptitudeStatus @default(NON_EVALUE)
  conduiteGroupeLourd  AptitudeStatus @default(NON_EVALUE)
  opex                 AptitudeStatus @default(NON_EVALUE)
  contreIndicationEPMS Boolean        @default(false)

  observations   String?              @db.Text
  conclusion     ConclusionEngagement
  lieu           String
  dateCertificat DateTime             @default(now())

  // PDF généré à la création et stocké directement dans le dossier du patient.
  pdf          Bytes?
  pdfGenereLe  DateTime?

  // Annulation : le document reste dans le dossier (traçabilité) mais n'est
  // plus pris en compte dans les statuts (aptitude, etc.).
  annuleLe    DateTime?
  annuleMotif String?   @db.Text

  medecin          User   @relation("MedecinCertificatsEngagement", fields: [medecinId], references: [id])
  medecinId        String
  medecinSignature String? // dataURL/base64 ou référence vers un fichier de signature

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  profilSigycop   ProfilSigycop? @relation(fields: [profilSigycopId], references: [id])
  profilSigycopId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("certificats_engagement")
}

model CertificatSuiviAptitudes {
  id String @id @default(cuid())

  nom    String
  prenom String
  ddn    DateTime
  rio    String

  s Int
  i Int
  g Int
  y Int
  c Int
  o Int
  p Int

  aptitudeGeneraleSPP  AptitudeStatus @default(NON_EVALUE)
  aptitudeInitialeGES  AptitudeStatus @default(NON_EVALUE)
  aptitudeMIR          AptitudeStatus @default(NON_EVALUE)
  aptitudeGRIMP        AptitudeStatus @default(NON_EVALUE)
  aptitudeNRBCe        AptitudeStatus @default(NON_EVALUE)
  aptitudeGHSC         AptitudeStatus @default(NON_EVALUE)
  conduiteGroupeLeger  AptitudeStatus @default(NON_EVALUE)
  conduiteGroupeLourd  AptitudeStatus @default(NON_EVALUE)
  opex                 AptitudeStatus @default(NON_EVALUE)
  contreIndicationEPMS Boolean        @default(false)

  observations   String?          @db.Text
  conclusion     ConclusionSuivi
  lieu           String
  dateCertificat DateTime         @default(now())

  // PDF généré à la création et stocké directement dans le dossier du patient.
  pdf          Bytes?
  pdfGenereLe  DateTime?

  // Annulation : le document reste dans le dossier (traçabilité) mais n'est
  // plus pris en compte dans les statuts (aptitude, etc.).
  annuleLe    DateTime?
  annuleMotif String?   @db.Text

  medecin          User   @relation("MedecinCertificatsSuivi", fields: [medecinId], references: [id])
  medecinId        String
  medecinSignature String?

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  profilSigycop   ProfilSigycop? @relation(fields: [profilSigycopId], references: [id])
  profilSigycopId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("certificats_suivi_aptitudes")
}

/// Consultation de médecine classique (motif, examen clinique, constantes, diagnostic).
/// Distincte des certificats d'aptitude : c'est le suivi médical courant du patient.
model Consultation {
  id               String   @id @default(cuid())
  dateConsultation DateTime @default(now())

  motif           String
  anamnese        String? @db.Text
  examenClinique  String? @db.Text

  // Constantes relevées pendant la consultation
  temperature        Float?
  tensionSystolique  Int?
  tensionDiastolique Int?
  frequenceCardiaque Int?
  saturationO2       Int?
  poids              Float?
  taille             Float?

  diagnostic      String? @db.Text
  conduiteATenir  String? @db.Text

  annuleLe    DateTime?
  annuleMotif String?   @db.Text

  medecin   User   @relation("MedecinConsultations", fields: [medecinId], references: [id])
  medecinId String

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  piecesJointes PieceJointe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("consultations")
}

/// Ordonnance : chaque ligne de `medicaments` porte sa propre posologie
/// ([{ nom, dosage, forme, posologie, duree }]). Le PDF généré est stocké
/// directement dans le dossier du patient, au même titre que les certificats.
model Prescription {
  id               String   @id @default(cuid())
  medicaments      Json
  instructions     String?  @db.Text
  lieu             String   @default("")
  datePrescription DateTime @default(now())

  pdf         Bytes?
  pdfGenereLe DateTime?

  annuleLe    DateTime?
  annuleMotif String?   @db.Text

  medecin   User   @relation("MedecinPrescriptions", fields: [medecinId], references: [id])
  medecinId String

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("prescriptions")
}

model ArretTravail {
  id                   String        @id @default(cuid())
  dateDebut            DateTime
  dateFin              DateTime
  typeExemption        TypeExemption
  motif                String?       @db.Text // Secret médical : jamais exposé au COMMANDEMENT
  transmisCommandement Boolean       @default(false)

  medecin   User   @relation("MedecinArretsTravail", fields: [medecinId], references: [id])
  medecinId String

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("arrets_travail")
}

/// Convocation à une visite médicale. Alimente le statut de visite exposé
/// au COMMANDEMENT ("Planifiée le DD/MM/YYYY") sans jamais exposer le motif.
model Convocation {
  id               String            @id @default(cuid())
  dateConvocation  DateTime
  motif            String?           @db.Text
  statut           StatutConvocation @default(PLANIFIEE)

  medecin   User   @relation("MedecinConvocations", fields: [medecinId], references: [id])
  medecinId String

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("convocations")
}

/// Journal d'audit du dossier patient : qui a créé/modifié/annulé quoi et quand.
/// `details` reste un résumé non sensible (jamais de diagnostic/motif en clair).
model JournalAudit {
  id      String  @id @default(cuid())
  action  String
  details String? @db.Text

  // Identifie le document concerné (certificat, ordonnance...) pour pouvoir
  // reconstituer son historique de versions. `donneesAvant` capture l'état
  // du document juste avant une modification.
  documentId   String?
  donneesAvant Json?

  utilisateur   User   @relation("AuteurJournal", fields: [utilisateurId], references: [id])
  utilisateurId String

  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String?

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([documentId])
  @@map("journal_audit")
}

/// Pièce jointe à une consultation (résultat de laboratoire, imagerie...).
model PieceJointe {
  id         String @id @default(cuid())
  nomFichier String
  typeMime   String
  taille     Int
  contenu    Bytes

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId String

  ajoutePar   User   @relation("AjouteParPieceJointe", fields: [ajouteParId], references: [id])
  ajouteParId String

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@map("pieces_jointes")
}
